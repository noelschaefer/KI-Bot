# Kopiere diese Datei, benenne die Kopie in ".env" um und trag deine Werte ein.
# Die Datei .env NIEMALS weitergeben oder auf GitHub hochladen!

# Token aus dem Discord Developer Portal (Bereich "Bot" -> "Reset Token")
DISCORD_TOKEN=hier-deinen-token-einfuegen

# Optional, aber empfohlen: ID deines Discord-Servers.
# Dann erscheinen die Befehle sofort. (Rechtsklick auf den Server -> "Server-ID kopieren",
# vorher in Discord unter Einstellungen -> Erweitert den Entwicklermodus einschalten)
GUILD_ID=

# Lokale KI über Ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODELL=llama3.2

# Nur nötig, wenn FFmpeg nicht gefunden wird, z. B.:
# FFMPEG_PFAD=C:\ffmpeg\bin\ffmpeg.exe
FFMPEG_PFAD=
